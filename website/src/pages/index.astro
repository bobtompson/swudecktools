---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/700.css';
import DeckTools from '../components/DeckTools.svelte';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SWU Deck Tools</title>
    <meta name="description" content="Sort Star Wars Unlimited decks by set and validate trilogy decklists." />
    <script is:inline>
      // Pick a random header key art before first paint (default is jtl without JS).
      document.documentElement.dataset.hero = Math.random() < 0.5 ? 'jtl' : 'lof';
      // Restore the alphabet preference before first paint (no FOUC).
      try {
        if (localStorage.getItem('swu-font') === 'aurebesh') {
          document.documentElement.dataset.font = 'aurebesh';
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="site-head-inner">
        <h1><span class="gold">SWU</span> Deck Tools</h1>
        <p>Sort a deck by set, or validate a three-deck trilogy.</p>
        <button id="font-toggle" type="button" title="Switch between Aurebesh and Galactic Basic"
          aria-label="Switch between Aurebesh and Galactic Basic"></button>
      </div>
    </header>
    <main>
      <DeckTools client:load />
    </main>
    <footer class="site-foot">
      <p>
        SWU Deck Tools is an unofficial fan site. It is not affiliated with, endorsed,
        sponsored, or approved by Lucasfilm Ltd., The Walt Disney Company, Fantasy Flight
        Games, or <em>Star Wars</em>: Unlimited.
      </p>
      <p>
        <em>Star Wars</em> characters, artwork, and trademarks are &copy; &amp; &trade;
        Lucasfilm Ltd. <em>Star Wars</em>: Unlimited and its logos are trademarks of
        Fantasy Flight Games.
      </p>
    </footer>

    <style is:global>
      :root {
        color-scheme: dark;
        /* space */
        --bg-space-1: #05070d;
        --bg-space-2: #0a0f1e;
        --bg-space-3: #16203a;
        --panel: rgba(15, 20, 32, 0.88);
        --panel-solid: #11161f;
        --line: #232c3d;
        --line-bright: #33405c;
        /* brand golds: --gold for text/hairline accents, --gold-deep for fills */
        --gold: #ffe81f;
        --gold-deep: #f2a900;
        --gold-dim: rgba(242, 169, 0, 0.35);
        /* text */
        --text: #e8edf5;
        --text-dim: #98a3b3;
        --text-faint: #5a6573;
        /* semantic colors (pre-theme hexes, tokenized) */
        --ok: #5cd17a;
        --bad: #f08a8a;
        --warn: #f0b44a;
        --reason: #f0b48a;
        --deck-1: #4a8cff;
        --deck-2: #f0b44a;
        --deck-3: #4ad1a0;
        --fmt-premier: #3b5bdb;
        --fmt-eternal: #7048e8;
        --fmt-twinsuns: #2f9e44;
        /* type */
        --font-basic: 'Barlow', system-ui, -apple-system, sans-serif;
        --font-body: var(--font-basic);
        --font-display: 'Barlow Condensed', var(--font-basic);
      }

      /* AurebeshAF Canon (AurekFonts, free personal+commercial — note in
         /fonts/) — the angular on-screen Aurebesh from the films. Swaps in via
         the header toggle; the font maps Latin letters to Aurebesh glyphs. */
      @font-face {
        font-family: 'Aurebesh';
        src: url('/fonts/aurebesh-af-canon.woff2') format('woff2');
        font-display: swap;
        /* Aurebesh has no lowercase: every glyph is cap-height (700/1000 vs
           Barlow's 506 x-height), so unscaled body text reads ~38% bigger.
           82% splits the difference between body and all-caps headers. */
        size-adjust: 82%;
      }
      :root[data-font='aurebesh'] {
        --font-body: 'Aurebesh', var(--font-basic);
        --font-display: 'Aurebesh', var(--font-basic);
      }
      /* Things that must stay legible in Basic: deck URLs you need to
         proofread, and the legal disclaimer. */
      :root[data-font='aurebesh'] input,
      :root[data-font='aurebesh'] .site-foot {
        font-family: var(--font-basic);
      }

      body {
        margin: 0;
        font-family: var(--font-body);
        background:
          radial-gradient(120% 90% at 70% -10%, var(--bg-space-3) 0%, var(--bg-space-2) 45%, var(--bg-space-1) 100%)
          var(--bg-space-1);
        color: var(--text);
        min-height: 100vh;
        /* Flex column so the footer anchors to the viewport bottom on short pages. */
        display: flex;
        flex-direction: column;
      }

      /* Starfield: two fixed star layers behind everything, oversized so they
         can drift slowly without exposing edges. Dense faint layer… */
      body::before {
        content: '';
        position: fixed;
        inset: -120px;
        z-index: -1;
        pointer-events: none;
        animation: star-drift-a 240s linear infinite alternate;
        background-image:
          radial-gradient(1px 1px at 25px 35px, rgba(255, 255, 255, 0.5), transparent),
          radial-gradient(1px 1px at 117px 203px, rgba(255, 255, 255, 0.4), transparent),
          radial-gradient(1px 1px at 199px 61px, rgba(255, 255, 255, 0.45), transparent),
          radial-gradient(1px 1px at 73px 149px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 161px 97px, rgba(255, 255, 255, 0.5), transparent),
          radial-gradient(1px 1px at 41px 227px, rgba(255, 255, 255, 0.3), transparent),
          radial-gradient(1px 1px at 217px 181px, rgba(255, 255, 255, 0.4), transparent),
          radial-gradient(1px 1px at 89px 13px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 47px 89px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 293px 313px, rgba(255, 255, 255, 0.3), transparent),
          radial-gradient(1px 1px at 173px 251px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 331px 137px, rgba(255, 255, 255, 0.3), transparent),
          radial-gradient(1px 1px at 251px 31px, rgba(255, 255, 255, 0.25), transparent);
        background-size:
          240px 240px, 240px 240px, 240px 240px, 240px 240px, 240px 240px,
          240px 240px, 240px 240px, 240px 240px,
          380px 380px, 380px 380px, 380px 380px, 380px 380px, 380px 380px;
      }

      /* …and a sparse bright layer with soft halos, drifting the other way
         (slight parallax) and gently twinkling. The dense layer stays at
         constant brightness so the field never visibly "blinks" as a whole. */
      body::after {
        content: '';
        position: fixed;
        inset: -120px;
        z-index: -1;
        pointer-events: none;
        opacity: 0.7;
        animation:
          star-drift-b 180s linear infinite alternate,
          star-twinkle 7s ease-in-out infinite;
        background-image:
          radial-gradient(2px 2px at 79px 113px, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.15) 60%, transparent),
          radial-gradient(1.5px 1.5px at 347px 419px, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.12) 60%, transparent),
          radial-gradient(2px 2px at 503px 227px, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.12) 60%, transparent),
          radial-gradient(1.5px 1.5px at 191px 331px, rgba(255, 232, 31, 0.7), rgba(255, 232, 31, 0.1) 60%, transparent);
        background-size: 560px 560px;
      }

      @keyframes star-drift-a {
        to { transform: translate3d(90px, 50px, 0); }
      }
      @keyframes star-drift-b {
        to { transform: translate3d(-70px, -40px, 0); }
      }
      @keyframes star-twinkle {
        0%, 100% { opacity: 0.55; }
        50% { opacity: 0.9; }
      }
      @media (prefers-reduced-motion: reduce) {
        body::before,
        body::after {
          animation: none;
          inset: 0;
        }
      }

      /* Official key art behind the title, darkened left-to-right so the text
         sits on near-solid space while the art shows through on the right.
         The variant (and its crop) is chosen at random by the head script via
         data-hero on <html>; --hero-y frames the faces in the thin band. */
      .site-head {
        --hero: url('/art/header-jtl.jpg');
        --hero-y: 30%;
        position: relative;
        padding: 2.75rem 0;
        border-bottom: 1px solid var(--line);
        background:
          linear-gradient(
            90deg,
            rgba(5, 7, 13, 0.94) 0%,
            rgba(5, 7, 13, 0.82) 30%,
            rgba(8, 11, 20, 0.45) 60%,
            rgba(5, 7, 13, 0.6) 100%
          ),
          var(--hero) center var(--hero-y) / cover no-repeat,
          rgba(8, 11, 20, 0.6);
      }
      :root[data-hero='lof'] .site-head {
        --hero: url('/art/header-lof.jpg');
        --hero-y: 25%;
      }
      /* Angled gold rule under the header, echoing starwarsunlimited.com. */
      .site-head::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -2px;
        height: 3px;
        width: min(420px, 55%);
        background: linear-gradient(90deg, var(--gold-deep), var(--gold) 60%, transparent);
        clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
      }
      .site-head-inner {
        position: relative;
        max-width: 1100px;
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      /* Alphabet toggle: always labeled in the alphabet it switches TO —
         a teaser in Basic mode, a readable escape hatch in Aurebesh mode. */
      #font-toggle {
        position: absolute;
        right: 1.5rem;
        top: 50%;
        translate: 0 -50%;
        padding: 0.4rem 0.8rem;
        background: rgba(8, 11, 20, 0.55);
        border: 1px solid var(--line-bright);
        border-radius: 999px;
        color: var(--text-dim);
        cursor: pointer;
        font-family: 'Aurebesh', var(--font-basic);
        font-size: 0.8rem;
        letter-spacing: 0.05em;
      }
      #font-toggle:hover {
        border-color: var(--gold-deep);
        color: var(--gold);
      }
      :root[data-font='aurebesh'] #font-toggle {
        font-family: var(--font-basic);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .site-head h1 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }
      .site-head h1 .gold {
        color: var(--gold);
      }
      .site-head p {
        margin: 0.25rem 0 0;
        color: var(--text-dim);
      }

      main {
        /* width:100% because body is a flex column: auto inline margins would
           otherwise shrink-wrap the content instead of filling to max-width. */
        width: 100%;
        padding: 1.5rem;
        max-width: 1100px;
        margin-inline: auto;
        box-sizing: border-box;
      }

      .site-foot {
        width: 100%;
        max-width: 1100px;
        margin: auto auto 0;
        padding: 1.25rem 1.5rem 2rem;
        box-sizing: border-box;
        border-top: 1px solid var(--line);
        color: var(--text-faint);
        font-size: 0.8rem;
        line-height: 1.5;
        text-align: center;
      }
      .site-foot p {
        margin: 0 0 0.5rem;
      }

      @media (max-width: 900px) {
        #font-toggle {
          right: 1rem;
          padding: 0.3rem 0.6rem;
          font-size: 0.72rem;
        }
        .site-head {
          --hero-y: 18%;
          padding: 1.25rem 0;
          background:
            linear-gradient(
              90deg,
              rgba(5, 7, 13, 0.92) 0%,
              rgba(5, 7, 13, 0.78) 45%,
              rgba(8, 11, 20, 0.55) 100%
            ),
            var(--hero) center var(--hero-y) / cover no-repeat,
            rgba(8, 11, 20, 0.6);
        }
        :root[data-hero='lof'] .site-head {
          --hero-y: 12%;
        }
        .site-head-inner {
          padding-inline: 1rem;
        }
        main {
          padding: 1rem;
        }
      }
    </style>
    <script is:inline>
      (() => {
        const btn = document.getElementById('font-toggle');
        const html = document.documentElement;
        const setLabel = () => {
          btn.textContent = html.dataset.font === 'aurebesh' ? 'Basic' : 'Aurebesh';
        };
        btn.addEventListener('click', () => {
          const on = html.dataset.font === 'aurebesh';
          if (on) delete html.dataset.font;
          else html.dataset.font = 'aurebesh';
          try {
            localStorage.setItem('swu-font', on ? 'basic' : 'aurebesh');
          } catch {}
          setLabel();
        });
        setLabel();
      })();
    </script>
  </body>
</html>
