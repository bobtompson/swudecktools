---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/700.css';
import DeckTools from '../components/DeckTools.svelte';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SWU Deck Tools</title>
    <meta name="description" content="Sort Star Wars Unlimited decks by set and validate trilogy decklists." />
  </head>
  <body>
    <header class="site-head">
      <div class="site-head-inner">
        <h1><span class="gold">SWU</span> Deck Tools</h1>
        <p>Sort a deck by set, or validate a three-deck trilogy.</p>
      </div>
    </header>
    <main>
      <DeckTools client:load />
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        /* space */
        --bg-space-1: #05070d;
        --bg-space-2: #0a0f1e;
        --bg-space-3: #16203a;
        --panel: rgba(15, 20, 32, 0.88);
        --panel-solid: #11161f;
        --line: #232c3d;
        --line-bright: #33405c;
        /* brand golds: --gold for text/hairline accents, --gold-deep for fills */
        --gold: #ffe81f;
        --gold-deep: #f2a900;
        --gold-dim: rgba(242, 169, 0, 0.35);
        /* text */
        --text: #e8edf5;
        --text-dim: #98a3b3;
        --text-faint: #5a6573;
        /* semantic colors (pre-theme hexes, tokenized) */
        --ok: #5cd17a;
        --bad: #f08a8a;
        --warn: #f0b44a;
        --reason: #f0b48a;
        --deck-1: #4a8cff;
        --deck-2: #f0b44a;
        --deck-3: #4ad1a0;
        --fmt-premier: #3b5bdb;
        --fmt-eternal: #7048e8;
        --fmt-twinsuns: #2f9e44;
        /* type */
        --font-body: 'Barlow', system-ui, -apple-system, sans-serif;
        --font-display: 'Barlow Condensed', var(--font-body);
      }

      body {
        margin: 0;
        font-family: var(--font-body);
        background:
          radial-gradient(120% 90% at 70% -10%, var(--bg-space-3) 0%, var(--bg-space-2) 45%, var(--bg-space-1) 100%)
          var(--bg-space-1);
        color: var(--text);
        min-height: 100vh;
      }

      /* Starfield: two fixed star layers behind everything. Dense faint layer… */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image:
          radial-gradient(1px 1px at 25px 35px, rgba(255, 255, 255, 0.5), transparent),
          radial-gradient(1px 1px at 117px 203px, rgba(255, 255, 255, 0.4), transparent),
          radial-gradient(1px 1px at 199px 61px, rgba(255, 255, 255, 0.45), transparent),
          radial-gradient(1px 1px at 73px 149px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 161px 97px, rgba(255, 255, 255, 0.5), transparent),
          radial-gradient(1px 1px at 41px 227px, rgba(255, 255, 255, 0.3), transparent),
          radial-gradient(1px 1px at 217px 181px, rgba(255, 255, 255, 0.4), transparent),
          radial-gradient(1px 1px at 89px 13px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 47px 89px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 293px 313px, rgba(255, 255, 255, 0.3), transparent),
          radial-gradient(1px 1px at 173px 251px, rgba(255, 255, 255, 0.35), transparent),
          radial-gradient(1px 1px at 331px 137px, rgba(255, 255, 255, 0.3), transparent),
          radial-gradient(1px 1px at 251px 31px, rgba(255, 255, 255, 0.25), transparent);
        background-size:
          240px 240px, 240px 240px, 240px 240px, 240px 240px, 240px 240px,
          240px 240px, 240px 240px, 240px 240px,
          380px 380px, 380px 380px, 380px 380px, 380px 380px, 380px 380px;
      }

      /* …and a sparse bright layer with soft halos. */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.7;
        background-image:
          radial-gradient(2px 2px at 79px 113px, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.15) 60%, transparent),
          radial-gradient(1.5px 1.5px at 347px 419px, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.12) 60%, transparent),
          radial-gradient(2px 2px at 503px 227px, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.12) 60%, transparent),
          radial-gradient(1.5px 1.5px at 191px 331px, rgba(255, 232, 31, 0.7), rgba(255, 232, 31, 0.1) 60%, transparent);
        background-size: 560px 560px;
      }

      .site-head {
        position: relative;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--line);
        background: rgba(8, 11, 20, 0.6);
      }
      /* Angled gold rule under the header, echoing starwarsunlimited.com. */
      .site-head::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -2px;
        height: 3px;
        width: min(420px, 55%);
        background: linear-gradient(90deg, var(--gold-deep), var(--gold) 60%, transparent);
        clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
      }
      .site-head-inner {
        max-width: 1100px;
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      .site-head h1 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }
      .site-head h1 .gold {
        color: var(--gold);
      }
      .site-head p {
        margin: 0.25rem 0 0;
        color: var(--text-dim);
      }

      main {
        padding: 1.5rem;
        max-width: 1100px;
        margin-inline: auto;
        box-sizing: border-box;
      }

      @media (max-width: 900px) {
        .site-head {
          padding: 1rem 0;
        }
        .site-head-inner {
          padding-inline: 1rem;
        }
        main {
          padding: 1rem;
        }
      }
    </style>
  </body>
</html>
