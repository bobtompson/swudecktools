{
  // Cloudflare Workers deploy config — read by `npx wrangler deploy` (the
  // deploy command in the dashboard's git-connected build).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swudecktools",
  "compatibility_date": "2026-06-01",
  // The cloudflare adapter's server entrypoint (adapter v13+; it used to be
  // the built file dist/_worker.js/index.js). It serves the CORS proxy
  // (/api/proxy/*); everything else is static.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Static build output (HTML, JS, fonts, card data). Requests matching a
    // file here are served directly; anything else falls through to the
    // worker — which is how /api/proxy/* reaches the proxy route.
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
